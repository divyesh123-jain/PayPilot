# Safe local default: no external requests are made in mock mode.
PAYPILOT_INTEGRATION_MODE=mock
# Payment adapter mode: mock and replay are deterministic/offline; live uses PayPal.
PAYMENT_MODE=mock

# PayPal sandbox (used when PAYPILOT_INTEGRATION_MODE is not mock)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Model selection: nvidia, nvidia-nemo, or gemini. Leave unset for deterministic mock output.
PAYPILOT_AI_PROVIDER=gemini
NVIDIA_NEMO_API_KEY=
NVIDIA_NEMO_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
NVIDIA_NEMO_BASE_URL=https://integrate.api.nvidia.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
